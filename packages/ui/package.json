{
  "name": "@amansanoj/ui",
  "version": "0.1.0",
  "description": "Pre-styled, high-performance React 19 UI component library powered by Base UI and @amansanoj/brand",
  "author": "Aman Sanoj",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/styles.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/components/button/index.js",
      "require": "./dist/components/button/index.cjs"
    },
    "./badge": {
      "types": "./dist/components/badge/index.d.ts",
      "import": "./dist/components/badge/index.js",
      "require": "./dist/components/badge/index.cjs"
    },
    "./card": {
      "types": "./dist/components/card/index.d.ts",
      "import": "./dist/components/card/index.js",
      "require": "./dist/components/card/index.cjs"
    },
    "./input": {
      "types": "./dist/components/input/index.d.ts",
      "import": "./dist/components/input/index.js",
      "require": "./dist/components/input/index.cjs"
    },
    "./textarea": {
      "types": "./dist/components/textarea/index.d.ts",
      "import": "./dist/components/textarea/index.js",
      "require": "./dist/components/textarea/index.cjs"
    },
    "./dialog": {
      "types": "./dist/components/dialog/index.d.ts",
      "import": "./dist/components/dialog/index.js",
      "require": "./dist/components/dialog/index.cjs"
    },
    "./dropdown-menu": {
      "types": "./dist/components/dropdown-menu/index.d.ts",
      "import": "./dist/components/dropdown-menu/index.js",
      "require": "./dist/components/dropdown-menu/index.cjs"
    },
    "./separator": {
      "types": "./dist/components/separator/index.d.ts",
      "import": "./dist/components/separator/index.js",
      "require": "./dist/components/separator/index.cjs"
    },
    "./container": {
      "types": "./dist/components/container/index.d.ts",
      "import": "./dist/components/container/index.js",
      "require": "./dist/components/container/index.cjs"
    },
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js",
      "require": "./dist/lib/utils.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.2"
  },
  "peerDependencies": {
    "@amansanoj/brand": ">=0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@amansanoj/brand": {
      "optional": true
    }
  },
  "devDependencies": {
    "@amansanoj/brand": "^3.0.8",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
